{
  "name": "godot-wingman",
  "version": "0.4.4",
  "description": "A local MCP server that lets any AI use the Godot editor like a human: see it, edit scenes, write scripts and play the game.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run server/src/main.ts",
    "bundle-addon": "bun run scripts/bundle-addon.ts",
    "build": "bun run bundle-addon && bun run scripts/build-binaries.ts",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run bundle-addon && tsc --noEmit",
    "test:unit": "bun test tests/unit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/bun": "^1.4.5",
    "typescript": "^7.0.2"
  }
}
